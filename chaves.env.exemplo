# Copie para chaves.env (que fica fora do git) e preencha. Uma chave por linha, sem aspas.
#   cp chaves.env.exemplo chaves.env
# Os scripts leem este arquivo sozinhos; não precisa de export.

# OpenRouter (interpretar_certidoes.py). Crie em https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Opcional: id do modelo como aparece em https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Portal da Transparência (fetch_dados.py --emendas). Gratuita:
# https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
PORTAL_TRANSPARENCIA_KEY=
